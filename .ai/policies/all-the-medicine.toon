allTheMedicine:
  version: 1
  principle: load-every-medicine-activate-only-applicable-treatments-resolve-conflicts-execute-relentlessly-prove-completion-stop
  dynamicInventorySource: .ai/manifests/skills.json
  includes: every-registered-public-skill, never-stop
  excludes: all-the-medicine
  selfRecursionAllowed: false
  statusValues: PENDING, CHECKED, ACTIVE, SATISFIED, NOT_APPLICABLE, BLOCKED_BY_HIGHER_PRIORITY_RULE
  executionPhases: instruction-and-permission-resolution, task-bootstrap, autonomous-execution-activation, evidence-and-reality-control, attention-and-scope-control, reasoning-balance, loop-and-recovery-control, adversarial-semantic-control, execution-and-verification, completion, context-and-memory-maintenance
  oneControlAtATime: true
  superpowerTier: god-mode
  superpowerType: meta-superpower
